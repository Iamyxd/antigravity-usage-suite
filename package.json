  "description": "Zero-patch CDP overlay for Antigravity: real-time context ring capsule, minimal 5h/weekly quota HUD, and token usage heatmap.",
  "main": "cdp-manager.js",
  "author": "Iamyxd",
  "repository": {
    "type": "git",
    "url": "https://github.com/Iamyxd/antigravity-usage-suite.git"
  },
  "homepage": "https://github.com/Iamyxd/antigravity-usage-suite#readme",
  "bugs": {
    "url": "https://github.com/Iamyxd/antigravity-usage-suite/issues"
  },
  "keywords": [
    "antigravity",
    "cdp",
    "context-window",
    "token-tracker",
    "quota-hud",
    "heatmap",
    "userscript",
    "web-extension"
  ],
  "engines": {
    "node": ">=22.4.0"
  },
  "scripts": {
    "build": "node scripts/build-bundle.js",
    "pretest": "node scripts/build-bundle.js",
